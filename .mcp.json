{
  "mcpServers": {
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--python", "3.11", "mcp-for-blender==2.2.7"],
      "env": {
        "UV_PYTHON_PREFERENCE": "only-managed",
        "DISABLE_TELEMETRY": "true",
        "BLENDER_MCP_SAFE_MODE": "1"
      }
    }
  }
}
